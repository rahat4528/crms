# Virga — Environment Variables Reference
# Copy to .env.local and update values

# Database (MongoDB Atlas / local)
VIRGA_DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/virga?retryWrites=true&w=majority
MODO_DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/virga?retryWrites=true&w=majority

# Authentication (Auth.js v5)
AUTH_SECRET=changeme_at_least_32_characters_random_string_here_now
AUTH_URL=http://localhost:3000

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Stripe Payments (test mode)
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=virga-media
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# Email (Resend)
RESEND_API_KEY=re_123456789_abcdef
MAIL_FROM=Virga <concierge@virga.store>

# AI Stylist (LLM)
LLM_API_KEY=sk-proj-...

# Redis / Upstash (Rate limiting)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# Observability
SENTRY_DSN=https://...@sentry.io/...
